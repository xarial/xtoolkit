<Window x:Class="Xarial.XToolkit.Wpf.Dialogs.EulaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Xarial.XToolkit.Wpf.Dialogs"
        mc:Ignorable="d"
        Height="450" Width="500" WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow"
        Title="License Agreement">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <RichTextBox x:Name="EulaRichTextBox_PART" Grid.Row="0" Margin="5" IsReadOnly="True"
                     IsDocumentEnabled="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        <Button Grid.Row="1" Width="75" Height="25" Margin="5" HorizontalAlignment="Right" Click="OnOk">
            <TextBlock Text="OK"/>
        </Button>
    </Grid>
</Window>
